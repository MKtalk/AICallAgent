<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/text_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/text_service_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_service_disconnected"
        android:textSize="16sp"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btn_open_accessibility_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_open_settings" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#EEF3FA"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_reply_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_reply_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/reply_off"
            android:textStyle="bold"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btn_auto_reply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:enabled="false"
            android:text="@string/auto_reply_start" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auto_reply_description"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_call_state_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_call_state"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingTop="24dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/text_call_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_default_state"
        android:textSize="15sp"
        android:paddingBottom="24dp" />

    <TextView
        android:id="@+id/text_call_diagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_scope_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/notice_feature_scope"
        android:textSize="13sp"
        android:textColor="#666666" />

    <Button
        android:id="@+id/btn_open_local_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/local_title" />

</LinearLayout>
</ScrollView>
